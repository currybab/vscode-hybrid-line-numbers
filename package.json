{
  "name": "hybrid-line-numbers",
  "displayName": "Hybrid Line Numbers",
  "description": "Toggle between absolute and relative line numbers in VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:hybrid-line-numbers.toggle",
    "onCommand:hybrid-line-numbers.gotoLine"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hybrid-line-numbers.toggle",
        "title": "Toggle Line Numbers Mode (Absolute/Relative)"
      },
      {
        "command": "hybrid-line-numbers.gotoLine",
        "title": "Go to Line (Hybrid)"
      }
    ],
    "keybindings": [
      {
        "command": "hybrid-line-numbers.gotoLine",
        "key": "ctrl+g",
        "mac": "alt+g",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Hybrid Line Numbers",
      "properties": {
        "hybridLineNumbers.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable/disable hybrid line numbers"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "pnpm run build -- --watch",
    "compile": "tsc -p ./",
    "watch-tsc": "tsc -watch -p ./",
    "pretest": "pnpm run build",
    "test": "node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.84.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "esbuild": "^0.19.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.0.0"
  }
}